{
  "name": "codiby-code",
  "type": "module",
  "version": "0.4.0",
  "license": "SEE LICENSE IN LICENSE",
  "main": "electron-dist/main.js",
  "scripts": {
    "dev": "bash run.sh",
    "ui:dev": "bun run scripts/build.ts --watch",
    "build": "PATH=\"/opt/homebrew/bin:$HOME/.bun/bin:$PATH\" tauri build",
    "replace": "nohup bash scripts/replace-app.sh </dev/null >/tmp/codiby-replace-bootstrap.log 2>&1 & disown",
    "build:replace": "bun run build && bun run replace",
    "build-server": "bun run scripts/build.ts",
    "bridge": "bun run server/index.ts",
    "bridge:dev": "bun --watch server/index.ts",
    "start": "bash run.sh",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:dev:no-server": "SKIP_DEV_SERVER_START=1 tauri dev",
    "version:bump": "bun run scripts/bump-version.ts",
    "electron:typecheck": "bunx tsc -p electron/tsconfig.json --noEmit",
    "electron:build:main": "bunx tsc -p electron/tsconfig.json && bun -e \"require('fs').writeFileSync('electron-dist/package.json', '{\\\"type\\\":\\\"commonjs\\\"}\\n')\"",
    "electron:bundle-resources": "bash scripts/electron-bundle-resources.sh",
    "electron:dev": "bun run scripts/electron-dev.ts",
    "electron:build": "bun run build-server && bun run electron:bundle-resources && bun run electron:build:main && electron-builder",
    "electron:build:mac": "bun run build-server && bun run electron:bundle-resources && bun run electron:build:main && electron-builder --mac dmg",
    "electron:build:win": "bun run build-server && bun run electron:bundle-resources && bun run electron:build:main && electron-builder --win nsis"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.2.114",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@heroui/react": "^3.0.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@monaco-editor/react": "4.7.0",
    "@openai/codex-sdk": "0.128.0",
    "@opencode-ai/sdk": "1.14.33",
    "@tauri-apps/api": "2.10.1",
    "@tauri-apps/plugin-notification": "2",
    "@tauri-apps/plugin-opener": "2.5.3",
    "@tauri-apps/plugin-shell": "2.3.5",
    "@types/qrcode": "^1.5.6",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "framer-motion": "^12.38.0",
    "gsap": "3.15.0",
    "lucide-react": "1.8.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwindcss": "^4.2.2",
    "telegraf": "4.16.3"
  },
  "devDependencies": {
    "@electron/notarize": "3.1.1",
    "@tauri-apps/cli": "2.10.1",
    "@types/bun": "^1.3.12",
    "@types/node": "25.7.0",
    "bun-plugin-tailwind": "0.1.2",
    "electron": "42.0.1",
    "electron-builder": "26.8.1"
  },
  "build": {
    "appId": "com.codiby.code",
    "productName": "Codiby Code",
    "asar": true,
    "directories": {
      "buildResources": "electron/build",
      "output": "electron-out"
    },
    "files": [
      "electron-dist/**/*",
      "dist/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "extraResources": [
      { "from": "electron/resources/server.js", "to": "server.js" },
      { "from": "electron/resources/bun",       "to": "bun" },
      { "from": "scripts/codiby",               "to": "scripts/codiby" }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "electron/build/entitlements.mac.plist",
      "entitlementsInherit": "electron/build/entitlements.mac.plist",
      "icon": "src-tauri/icons/icon.icns",
      "target": [
        { "target": "dmg", "arch": ["arm64", "x64"] }
      ]
    },
    "win": {
      "icon": "src-tauri/icons/icon.ico",
      "target": ["nsis"]
    },
    "afterSign": "electron/build/notarize.cjs"
  }
}
