{
  "name": "codiby-code",
  "type": "module",
  "version": "0.16.0",
  "license": "SEE LICENSE IN LICENSE",
  "main": "electron-dist/main.js",
  "scripts": {
    "dev": "bash run.sh",
    "ui:dev": "bun run scripts/build.ts --watch",
    "build-server": "bun run scripts/build.ts",
    "bridge": "bun run server/index.ts",
    "bridge:dev": "bun --watch server/index.ts",
    "start": "bash run.sh",
    "version:bump": "bun run scripts/bump-version.ts",
    "electron:typecheck": "bunx tsc -p electron/tsconfig.json --noEmit",
    "electron:build:main": "bunx tsc -p electron/tsconfig.json && bun -e \"require('fs').writeFileSync('electron-dist/package.json', '{\\\"type\\\":\\\"commonjs\\\"}\\n')\"",
    "electron:bundle-resources": "bash scripts/electron-bundle-resources.sh",
    "electron:dev": "bun run scripts/electron-dev.ts",
    "electron:build": "bun run build-server && bun run electron:bundle-resources && bun run electron:build:main && electron-builder",
    "electron:build:mac": "bun run build-server && bun run electron:bundle-resources && bun run electron:build:main && electron-builder --mac dmg",
    "electron:build:win": "bun run build-server && bun run electron:bundle-resources && bun run electron:build:main && electron-builder --win nsis",
    "electron:replace": "nohup bash scripts/electron-replace-app.sh </dev/null >/tmp/codiby-electron-replace-bootstrap.log 2>&1 & disown",
    "electron:build:replace": "bash scripts/electron-build-and-replace.sh"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.159",
    "@anthropic-ai/sdk": "0.100.1",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@heroui/react": "^3.0.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@monaco-editor/react": "4.7.0",
    "@openai/codex-sdk": "0.128.0",
    "@opencode-ai/sdk": "1.14.33",
    "@types/qrcode": "^1.5.6",
    "@vscode/ripgrep": "1.18.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "framer-motion": "^12.38.0",
    "gsap": "3.15.0",
    "lucide-react": "1.8.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwindcss": "^4.2.2",
    "telegraf": "4.16.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@electron/notarize": "3.1.1",
    "@types/bun": "^1.3.12",
    "@types/node": "25.7.0",
    "bun-plugin-tailwind": "0.1.2",
    "electron": "42.0.1",
    "electron-builder": "26.8.1"
  },
  "build": {
    "appId": "com.codiby.code",
    "productName": "Codiby Code",
    "asar": true,
    "directories": {
      "buildResources": "electron/build",
      "output": "electron-out"
    },
    "files": [
      "electron-dist/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "electron/resources/server.js",
        "to": "server.js"
      },
      {
        "from": "electron/resources/bun",
        "to": "bun"
      },
      {
        "from": "electron/resources/rg",
        "to": "rg"
      },
      {
        "from": "scripts/codiby",
        "to": "scripts/codiby"
      },
      {
        "from": "dist",
        "to": "dist"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "electron/build/entitlements.mac.plist",
      "entitlementsInherit": "electron/build/entitlements.mac.plist",
      "icon": "electron/build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "extraResources": [
        {
          "from": "electron/resources/bun",
          "to": "bun"
        }
      ]
    },
    "win": {
      "icon": "electron/build/icon.ico",
      "target": [
        "nsis"
      ],
      "extraResources": [
        {
          "from": "electron/resources/bun.exe",
          "to": "bun.exe"
        }
      ]
    },
    "afterSign": "electron/build/notarize.cjs"
  }
}
