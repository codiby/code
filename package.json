{
  "name": "codiby-code",
  "type": "module",
  "version": "0.26.0",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "main": "electron-dist/main.js",
  "workspaces": [
    "packages/*"
  ],
  "dependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "scripts": {
    "dev": "bash run.sh",
    "ui:dev": "bun run scripts/build.ts --watch",
    "build-server": "bun run scripts/build.ts",
    "bridge": "bun run packages/core/index.ts",
    "bridge:dev": "bun --watch packages/core/index.ts",
    "start": "bash run.sh",
    "version:bump": "bun run scripts/bump-version.ts",
    "electron:typecheck": "bunx tsc -p packages/desktop/tsconfig.json --noEmit",
    "electron:build:main": "bunx tsc -p packages/desktop/tsconfig.json && bun -e \"require('fs').writeFileSync('electron-dist/package.json', '{\\\"type\\\":\\\"commonjs\\\"}\\n')\"",
    "electron:bundle-resources": "bash scripts/electron-bundle-resources.sh",
    "electron:dev": "bun run scripts/electron-dev.ts",
    "electron:build": "bun run build-server && bun run electron:bundle-resources && bun run electron:build:main && electron-builder",
    "electron:build:mac": "bun run build-server && bun run electron:bundle-resources && bun run electron:build:main && electron-builder --mac dmg",
    "electron:build:win": "bun run build-server && bun run electron:bundle-resources && bun run electron:build:main && electron-builder --win nsis",
    "electron:replace": "nohup bash scripts/electron-replace-app.sh </dev/null >/tmp/codiby-electron-replace-bootstrap.log 2>&1 & disown",
    "electron:build:replace": "bash scripts/electron-build-and-replace.sh",
    "electron:replace:dist": "bash scripts/electron-replace-dist.sh"
  },
  "devDependencies": {
    "@electron/notarize": "3.1.1",
    "@types/bun": "^1.3.12",
    "@types/node": "25.7.0",
    "bun-plugin-tailwind": "0.1.2",
    "electron": "42.5.0",
    "electron-builder": "26.8.1",
    "swagger-ui-dist": "5.32.6",
    "typescript": "5.9.3"
  },
  "build": {
    "appId": "com.codiby.code",
    "productName": "Codiby Code",
    "asar": true,
    "directories": {
      "buildResources": "packages/desktop/build",
      "output": "electron-out"
    },
    "files": [
      "electron-dist/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "packages/desktop/resources/server.js",
        "to": "server.js"
      },
      {
        "from": "packages/desktop/resources/bun",
        "to": "bun"
      },
      {
        "from": "packages/desktop/resources/rg",
        "to": "rg"
      },
      {
        "from": "scripts/codiby",
        "to": "scripts/codiby"
      },
      {
        "from": "scripts/electron-install-update.sh",
        "to": "scripts/electron-install-update.sh"
      },
      {
        "from": "dist",
        "to": "dist"
      },
      {
        "from": "packages/desktop/resources/swagger-ui-dist",
        "to": "swagger-ui-dist"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "packages/desktop/build/entitlements.mac.plist",
      "entitlementsInherit": "packages/desktop/build/entitlements.mac.plist",
      "icon": "packages/desktop/build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "extraResources": [
        {
          "from": "packages/desktop/resources/bun",
          "to": "bun"
        }
      ]
    },
    "win": {
      "icon": "packages/desktop/build/icon.ico",
      "target": [
        "nsis"
      ],
      "extraResources": [
        {
          "from": "packages/desktop/resources/bun.exe",
          "to": "bun.exe"
        }
      ]
    },
    "afterSign": "packages/desktop/build/notarize.cjs"
  }
}
