{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0",
    "lib": ["ES2023"],
    "outDir": "../../electron-dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": false,
    "sourceMap": true,
    "declaration": false,
    "types": ["bun"]
  },
  "include": ["**/*.ts"],
  "exclude": ["../../node_modules", "../../electron-dist", "../../dist", "../ui", "../core"]
}
