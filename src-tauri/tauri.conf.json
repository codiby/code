{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "claude-code-ui",
  "version": "0.1.0",
  "identifier": "com.jovaz.claude-code-ui",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:4321",
    "beforeBuildCommand": "./scripts/bundle-bun.sh && bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Claude Code",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "transparent": true,
        "titleBarStyle": "Overlay"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["sidecar/server.ts", "sidecar/bun"]
  }
}
