{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codiby Code",
  "version": "0.4.0",
  "identifier": "com.codiby.code",
  "build": {
    "beforeDevCommand": "bash run.sh",
    "devUrl": "http://localhost:3111",
    "beforeBuildCommand": "bash scripts/bundle-bun.sh && bun run build-server",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "titleBarStyle": "Overlay"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "sidecar/server.js": "server.js",
      "../dist": "dist"
    },
    "externalBin": ["sidecar/bun"],
    "windows": {
      "wix": {
        "language": "en-US"
      },
      "nsis": {
        "installMode": "perMachine",
        "languages": ["English"]
      }
    }
  }
}
